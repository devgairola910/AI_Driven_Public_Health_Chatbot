{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "{*.html,src/**,data/**,*.webmanifest,sw.js}"
    },
    "api/index.js": {
      "includeFiles": "{*.html,src/**,data/**,*.webmanifest,sw.js}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
